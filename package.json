{
  "name": "sop-runtime-agentd",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Runtime-local supervisor for SOP A2A agent engines, sessions, skills, events, and artifacts.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node --disable-warning=ExperimentalWarning dist/src/main.js",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.83.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9"
  }
}
